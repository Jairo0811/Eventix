MSSQL_SA_PASSWORD=replace-with-a-strong-sa-password
EVENTIX_DB_PASSWORD=replace-with-a-strong-eventix-password
EVENTIX_MIGRATOR_PASSWORD=replace-with-a-distinct-migrator-password

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=EventixDb;encrypt=true;trustServerCertificate=true
DB_USERNAME=eventix_app
DB_PASSWORD=replace-with-the-eventix-database-password

APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_PROFILE=dev

# En producción usa APP_PROFILE=prod y APP_BASE_URL con HTTPS.
EVENTIX_ALLOW_DEFAULT_BOOTSTRAP_ADMIN=true
EVENTIX_BOOTSTRAP_ADMIN_PASSWORD=

# Clave estable para HMAC-SHA-256 de cédulas usadas en intentos de elegibilidad.
# Genera una con: openssl rand -hex 32
EVENTIX_ELIGIBILITY_HMAC_SECRET=replace-with-a-random-64-character-hex-value

# Solo para desarrollo local: identidades ficticias en formato
# cedula=Nombre Completo;cedula=Nombre Completo
# No utilices datos reales aquí ni en el repositorio.
EVENTIX_IDENTITY_DEV_RECORDS=

# SMTP. Activa recordatorios solo cuando el proveedor esté configurado.
EVENTIX_EMAIL_ENABLED=false
EVENTIX_EMAIL_FROM=no-reply@eventix.local
EVENTIX_REMINDERS_ENABLED=false
EVENTIX_REMINDER_ADVANCE=PT24H
EVENTIX_REMINDER_SCAN_INTERVAL=PT5M
EVENTIX_REMINDER_RETRY_DELAY=PT15M
EVENTIX_REMINDER_MAX_ATTEMPTS=5
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# AZUL / Apple Pay / Google Pay (opcional).
AZUL_WALLET_ENABLED=false
AZUL_WALLET_ENVIRONMENT=TEST
AZUL_STORE=
AZUL_AUTH1=
AZUL_AUTH2=
AZUL_CHANNEL=EC
AZUL_APPLE_INITIATIVE_CONTEXT=
AZUL_GOOGLE_MERCHANT_ID=
AZUL_APPLE_DOMAIN_ASSOCIATION=

# Google Maps Embed API (opcional).
# Si queda vacía, Eventix mantiene una vista previa básica por lugar/dirección.
# En producción configura una clave de Maps Embed API restringida por dominio.
GOOGLE_MAPS_EMBED_API_KEY=

# Fase 5: usa claves Ed25519 persistentes fuera de desarrollo.
TICKETING_ISSUER_NAME=Eventix
TICKETING_SIGNING_KEY_ID=eventix-dev
TICKETING_SIGNING_PRIVATE_KEY=
TICKETING_SIGNING_PUBLIC_KEY=
TICKETING_VERIFICATION_PUBLIC_KEYS=
TICKETING_ALLOW_EPHEMERAL_SIGNING_KEY=true
TICKETING_ALLOW_REENTRY=false
TICKETING_EXPIRATION_SCAN_INTERVAL=PT5M

# Google Wallet (opcional; JSON literal o prefijo base64:).
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_WALLET_ORIGINS=http://localhost:8080

# Apple Wallet (opcional; certificados en Base64, sin guardarlos aquí).
APPLE_WALLET_ENABLED=false
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_TEAM_IDENTIFIER=
APPLE_WALLET_CERTIFICATE_P12=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_CERTIFICATE=
APPLE_WALLET_WEB_SERVICE_URL=http://localhost:8080/api/wallet/apple/v1
APPLE_WALLET_APNS_ENABLED=false
APPLE_WALLET_APNS_PRODUCTION=false
